{
  "name": "taiwan-stock-subscription-alert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "tsc -p tsconfig.worker.json && wrangler deploy --dry-run --outdir .wrangler-dist",
    "test": "vitest run",
    "check": "npm run build && npm run build:worker && npm test",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "worker:dev": "wrangler dev --test-scheduled",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  }
}
